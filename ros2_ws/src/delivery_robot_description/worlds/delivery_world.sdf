<?xml version="1.0" ?>

<sdf version="1.9">

  <world name="delivery_world">

    <!-- ========================= -->
    <!-- REQUIRED SYSTEM PLUGINS   -->
    <!-- ========================= -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>


    <!-- ========================= -->
    <!-- LIGHT                     -->
    <!-- ========================= -->

    <light type="directional" name="sun">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.1 -0.9</direction>

    </light>


    <!-- ========================= -->
    <!-- OFFICE FLOOR              -->
    <!-- ========================= -->

    <model name="office_floor">

      <static>true</static>

      <link name="floor_link">

        <collision name="floor_collision">

          <geometry>
            <box>
              <size>16 12 0.1</size>
            </box>
          </geometry>

        </collision>

        <visual name="floor_visual">

          <geometry>
            <box>
              <size>16 12 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================= -->
    <!-- OUTER OFFICE WALLS        -->
    <!-- ========================= -->

    <!-- North wall -->
    <model name="north_wall">

      <static>true</static>

      <pose>0 6 1.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>16 0.2 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>16 0.2 2.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- South wall -->
    <model name="south_wall">

      <static>true</static>

      <pose>0 -6 1.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>16 0.2 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>16 0.2 2.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- West wall -->
    <model name="west_wall">

      <static>true</static>

      <pose>-8 0 1.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 12 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>0.2 12 2.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- East wall -->
    <model name="east_wall">

      <static>true</static>

      <pose>8 0 1.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 12 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>0.2 12 2.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================= -->
    <!-- INTERIOR OFFICE WALLS     -->
    <!-- ========================= -->

    <model name="office_partition_1">

      <static>true</static>

      <pose>-3 2.8 1.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>5 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5 0.15 2.5</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <model name="office_partition_2">

      <static>true</static>

      <pose>3 2.8 1.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4 0.15 2.5</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <model name="meeting_room_wall">

      <static>true</static>

      <pose>-3 -2.5 1.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>5 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5 0.15 2.5</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ========================= -->
    <!-- DESKS                     -->
    <!-- ========================= -->

    <model name="desk_1">

      <static>true</static>

      <pose>-5 4.2 0.4 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.8 0.8 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>1.8 0.8 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.45 0.25 0.12 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <model name="desk_2">

      <static>true</static>

      <pose>4.7 4.2 0.4 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.8 0.8 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>1.8 0.8 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.45 0.25 0.12 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <model name="desk_3">

      <static>true</static>

      <pose>-5 -4 0.4 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.8 0.8 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>1.8 0.8 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.45 0.25 0.12 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================= -->
    <!-- MEETING TABLE             -->
    <!-- ========================= -->

    <model name="meeting_table">

      <static>true</static>

      <pose>-2 -4 0.45 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2.5 1.2 0.9</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>2.5 1.2 0.9</size>
            </box>
          </geometry>

          <material>
            <ambient>0.30 0.18 0.08 1</ambient>
            <diffuse>0.30 0.18 0.08 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================= -->
    <!-- DELIVERY STATION          -->
    <!-- ========================= -->

    <model name="delivery_station">

      <static>true</static>

      <pose>5 -4.5 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 1.5 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>1.5 1.5 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.2 0.6 0.2 1</ambient>
            <diffuse>0.2 0.6 0.2 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================= -->
    <!-- EXTRA OBSTACLES           -->
    <!-- ========================= -->

    <model name="office_obstacle_1">

      <static>true</static>

      <pose>1 0 0.45 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 0.9</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>0.8 0.8 0.9</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.25 0.15 1</ambient>
            <diffuse>0.7 0.25 0.15 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <model name="office_obstacle_2">

      <static>true</static>

      <pose>4 0.5 0.45 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>

        </visual>

      </link>

    </model>


  </world>

</sdf>